{
  "name": "@payrail/api",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json && esbuild src/serverless.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=api/index.mjs",
    "start": "node dist/main.js",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "esbuild": "0.28.2",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@types/pg": "8.23.1",
    "vitest": "5.0.5"
  }
}
